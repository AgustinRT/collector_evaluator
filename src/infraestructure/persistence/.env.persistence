# Local development defaults. Real environment variables take precedence over this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=collector_evaluator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional startup parameters (also available as CLI flags: python main.py --help)
# DATABASE_URL=postgresql://user:password@host:5432/dbname   # overrides the POSTGRES_* values
# DATABASE_NAME=collector_evaluator_test                    # overrides only the database name
# DATABASE_FALLBACK_TO_MEMORY=true                          # use in-memory SQLite if PostgreSQL is down
# DATABASE_CONNECT_TIMEOUT=5
